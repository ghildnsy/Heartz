    {
      "name": "Predict",
      "item": [
        {
          "name": "POST /api/predict (upload audio)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "audio",
                  "type": "file",
                  "description": "Attach file WAV di sini (PCM 16-bit mono 16kHz). Maksimal durasi perekaman 5.0 detik."
                },
                {
                  "key": "targetSyllableId",
                  "value": "syl_vokal_a_id_dari_database",
                  "type": "text",
                  "description": "ID unik suku kata target yang diambil dari baris data master syllables di database AWS RDS."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/predict",
              "host": ["{{baseUrl}}"],
              "path": ["api", "predict"]
            },
            "description": "Mengunggah audio ke S3, menembak Flask AI Model, melakukan perbandingan logika bisnis, dan mencatat data transaksional ke database PostgreSQL."
          },
          "response": [
            {
              "name": "200 OK - Real AI Prediction Result",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"success\",\n  \"statusCode\": 200,\n  \"message\": \"Audio berhasil diproses oleh model AI.\",\n  \"data\": {\n    \"sessionId\": \"prc_sess_9912\",\n    \"date\": \"2026-05-28T07:44:12.110Z\",\n    \"targetSyllable\": \"ma\",\n    \"predictedSyllable\": \"ma\",\n    \"isCorrect\": true,\n    \"accuracyScore\": 0.9375522136688232,\n    \"affirmation\": \"Luar biasa, akurasi 93,8% untuk pelafalan 'ma' itu keren sekali, terus semangat berlatih ya!\"\n  }\n}"
            }
          ]
        }
      ]
    },
